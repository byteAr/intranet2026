# ============================================================
# .env.staging — Copiar el .env de producción y ajustar estos valores
# ============================================================

# PostgreSQL — apunta a la base de datos de PRODUCCIÓN (comparte emails y datos reales)
POSTGRES_HOST=intranet_postgres
POSTGRES_PORT=5432
POSTGRES_DB=<mismo que produccion>
POSTGRES_USER=<mismo que produccion>
# POSTGRES_PASSWORD viene del secret postgres_password.txt (mismo que prod)

# JWT — OBLIGATORIO usar un valor DISTINTO al de producción
# El JWT viene del secret jwt_secret_staging.txt (diferente a jwt_secret.txt)
JWT_EXPIRES_IN=8h

# LDAP — mismo que producción
LDAP_URL=ldap://10.98.40.22:389
LDAP_BIND_DN=<mismo que produccion>
LDAP_BIND_CREDENTIALS=<mismo que produccion>
LDAP_SEARCH_BASE=<mismo que produccion>
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_TLS_REJECT_UNAUTHORIZED=false

# SMTP (OTP) — mismo que producción
SMTP_HOST=<mismo que produccion>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<mismo que produccion>
SMTP_FROM=<mismo que produccion>
# SMTP_PASS viene del secret smtp_pass.txt (mismo que prod)

# Módulo de correo — staging NO recibe emails nuevos en tiempo real
# (los emails existentes se ven porque comparte la DB de prod)
# Dejar vacío para deshabilitar envío de correo real desde staging
MAIL_SMTP_FROM=
MAIL_ATTACHMENTS_PATH=/app/storage/attachments
MAIL_PST_UPLOAD_PATH=/app/storage/pst

# Mail Bridge — dejar vacío en staging (staging no recibe ingesta del bridge)
# MAIL_BRIDGE_URL=
# MAIL_BRIDGE_SECRET viene del secret mail_bridge_secret.txt

# Draft Mail
DRAFT_MAIL_SUPER_APPROVERS=<mismo que produccion>
DRAFT_ATTACHMENTS_PATH=/app/storage/draft-attachments

# App
FRONTEND_URL=http://10.98.40.24:8281
APP_PORT=3000
NODE_ENV=production
COOKIE_SECURE=false
